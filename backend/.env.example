MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/thermalai
PORT=5000
JWT_SECRET=<generate-a-random-32-char-string>
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=<gmail-app-password-not-account-password>
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_PHONE=+1XXXXXXXXXX
ALERT_PHONE=+91XXXXXXXXXX
OPERATOR_PHONE=+91XXXXXXXXXX
ADMIN_PHONE=+91XXXXXXXXXX
# Per-plant contact overrides (optional — falls back to ALERT_PHONE / EMAIL_USER if unset)
PLANT1_PHONE=+91XXXXXXXXXX
PLANT1_EMAIL=plant1-operator@example.com
PLANT2_PHONE=+91XXXXXXXXXX
PLANT2_EMAIL=plant2-operator@example.com
PLANT3_PHONE=+91XXXXXXXXXX
PLANT3_EMAIL=plant3-operator@example.com
ML_URL=http://localhost:5001
