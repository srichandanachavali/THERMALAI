MONGO_URI=mongodb+srv://<db-user>:<db-password>@cluster0.example.mongodb.net/?appName=Cluster0
PORT=5000
JWT_SECRET=<generate-a-random-32-char-string>
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=<gmail-app-password-not-account-password>
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_PHONE=+1XXXXXXXXXX
ALERT_PHONE=+91XXXXXXXXXX
OPERATOR_PHONE=+91XXXXXXXXXX
ADMIN_PHONE=+91XXXXXXXXXX
# Per-plant contact overrides (optional — falls back to ALERT_PHONE / EMAIL_USER if unset)
PLANT1_PHONE=+91XXXXXXXXXX
PLANT1_EMAIL=plant1-operator@example.com
PLANT2_PHONE=+91XXXXXXXXXX
PLANT2_EMAIL=plant2-operator@example.com
PLANT3_PHONE=+91XXXXXXXXXX
PLANT3_EMAIL=plant3-operator@example.com
ML_URL=http://localhost:5001

# ── v1.2.0 security hardening ─────────────────────────────────────────────
# CORS allow-list. Comma-separated origins accepted by Express, socket.io,
# and Flask. Never use "*" in production.
FRONTEND_ORIGIN=http://localhost:3000

# Simulator (ml-model/stream_data.py) login. In dev, the seeded demo user works.
# In prod, provision a dedicated service account with the minimum role required.
SIM_USER=operator
SIM_PASS=op123

# Seed account passwords. Override in prod with strong secrets; these defaults
# are dev-only demo accounts.
SEED_ADMIN_PASSWORD=admin123
SEED_SUPERADMIN_PASSWORD=super123
SEED_OPERATOR_PASSWORD=op123

# Shared secret the Flask ML API requires via X-ML-Key (1H). When empty, the
# ML gate is disabled for local dev. In prod set a strong value in both services.
ML_API_KEY=
